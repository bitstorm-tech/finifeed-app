# Copy to apps/server/.env. Only DATABASE_URL is required in development.

# development | test | production
APP_ENV=development
PORT=3000
# Required. Connection string of an existing PostgreSQL database (user and database must exist).
DATABASE_URL=postgres://finifeed:finifeed@localhost:5432/finifeed
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# text (readable lines via pino-pretty) | json. Defaults to text in development, json otherwise.
LOG_FORMAT=text
# YouTube Data API v3 key (Google Cloud console). Required in production; without it adding creators fails.
YOUTUBE_API_KEY=
