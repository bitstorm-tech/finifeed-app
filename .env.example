# Copy to apps/server/.env to override defaults. All values are optional in development.

# development | test | production
APP_ENV=development
PORT=3000
# Required in production. Defaults to the docker-compose database in development/test.
DATABASE_URL=postgres://finifeed:finifeed@localhost:5433/finifeed
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
